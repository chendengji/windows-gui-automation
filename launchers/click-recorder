#!/usr/bin/env bash
# click-recorder 启动器 —— 不依赖当前目录，任何位置可调用。
#
# 项目根解析顺序：
#   1. 环境变量 CLICK_RECORDER_HOME（推荐：搬家后改这一个变量，已固化的脚本也跟着生效）
#   2. 默认安装位置
#
# 用法： click-recorder record|list|search|show|play|upgrade|rebase [参数]
ROOT="${CLICK_RECORDER_HOME:-$HOME/Documents/literature-review/tmp/click-recorder}"
if [ ! -d "$ROOT" ]; then
  echo "错误：未找到 click-recorder 项目根：$ROOT" >&2
  echo "请设置环境变量 CLICK_RECORDER_HOME 指向实际安装位置。" >&2
  exit 1
fi
cd "$ROOT" || exit 1
exec uv run python -m click_recorder.cli "$@"